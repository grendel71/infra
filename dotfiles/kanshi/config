# laptop docked
output "Dell Inc. DELL S2715H V14F36CNAVJL" {
  mode 1920x1080@60.0
  position 0,0
  scale 1
  alias $HOME_1
}
# laptop internal

output "AU Optronics 0x3CAD Unknown" {
    mode 1920x1200@60.0
    position 0,0
    scale 1.0
    alias $LAPTOP_SCREEN
}

output "Dell Inc. DELL S2715H V14F3713AHYL" {
    mode 1920x1080@60.0
    position 1920,0
    scale 1.0
    alias $DESKTOP_ALTSCREEN
}

output "Sceptre Tech Inc Sceptre F27 0x01010101" {
    mode 1920x1080@100.0
    position 0,0
    scale 1.0
    alias $DESKTOP_MAIN
}



profile home_1 {
  output $HOME_1 enable
  output "AU Optronics 0x3CAD Unknown" enable scale 1.5
}

profile mobile_laptop {
    output $LAPTOP_SCREEN enable
}

profile desktop {
    output $DESKTOP_MAIN enable
    output $DESKTOP_ALTSCREEN enable
}
profile home_2 {
	output $LAPTOP_SCREEN enable
	output $DESKTOP_ALTSCREEN enable
}

profile home_3 {
    output $LAPTOP_SCREEN 1920x1200 position 0,0 disable
    output $DESKTOP_MAIN 1920x1080 position 0,0 enable
    output $DESKTOP_ALTSCREEN 1920x1080 position 1920,0 enable
}
